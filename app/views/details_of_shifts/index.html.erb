<% content_for :title, "勤務依頼一覧" %>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    勤務調整
  </p>

  <h1 class="display-6 fw-bold">
    勤務依頼一覧
  </h1>

  <p class="page-lead text-body-secondary">
    依頼内容と現在の割当状況を確認できます。
  </p>
</div>

<% if @work_requests.any? %>
  <div class="row g-4">
    <table class="table table-bordered">
      <thead>
        <tr>
          <th>ステータス</th>
          <th>依頼名</th>
          <th>事業者</th>
          <th>必要人数</th>
          <th>割当済み</th>
          <th>不足人数</th>
          <th>必要スキル</th>
          <th>開始日時</th>
        </tr>
      </thead>

      <tbody>
        <% @work_requests.each do |work_request| %>
          <tr>
            <td><%= enum_label(work_request, :status) %></td>
            <td><%= link_to work_request.title, details_of_shift_path(work_request) %></td>
            <td><%= work_request.business.name %></td>
            <td><%= work_request.required_staff_count %></td>
            <td><%= work_request.assignments.size %></td>
            <td class="<%= work_request.staffing_sufficient? ? 'text-success' : 'text-danger' %>">
              <%= work_request.staffing_shortage_count %>
            </td>
            <td><%= work_request.required_skill&.name || "指定なし" %></td>
            <td><%= l work_request.starts_at, format: :short %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info">
    勤務依頼はまだ登録されていません。
  </div>
<% end %>
